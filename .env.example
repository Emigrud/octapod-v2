# Public connection settings. Copy this template to .env for local development.
# Use your own external project URL, project ID, and publishable key.
# Publishable keys are browser-safe; never put a service-role key in VITE_*.
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"
SUPABASE_PROJECT_ID="<your-project-ref>"
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# Private, server-only credentials. Set real values only in your secure
# hosting environment or ignored local .env file; never commit them.
INGEST_TRIGGER_TOKEN=""
OCTAPOD_DB_URL=""
OCTAPOD_SERVICE_ROLE_KEY=""